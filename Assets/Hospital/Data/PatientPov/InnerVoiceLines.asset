  m_Script: {fileID: 11500000, guid: c9fec6c792ae2e04ca64962192235a20, type: 3}
  m_Name: InnerVoiceLines
  m_EditorClassIdentifier: Assembly-CSharp::ProCommVR.Hospital.PatientPov.InnerVoiceLines
  Volume: 0.7
  Delay: 0.4
  SubtitleHold: 0.8
  Lines:
  - Emotion: 3
    Clip: {fileID: 8300000, guid: e704b43a28a8aaa4183463c9ed3fa292, type: 3}
    Text: She turns eight today. And I'm stuck in this bed.
  - Emotion: 1
    Clip: {fileID: 8300000, guid: 27000684070831d44839597fd826f1ed, type: 3}
    Text: Nobody listens. Nobody even asks.
  - Emotion: 2
    Clip: {fileID: 8300000, guid: ba508b7cbe1fa084585587435660d6f8, type: 3}
    Text: What if this leg never gets better?
  - Emotion: 0
    Clip: {fileID: 8300000, guid: 26c84339f05024c48a423f31c552abd5, type: 3}
    Text: Maybe I can still see her today.
