  BetterAimIntensity: 0.5
  BetterAim:
    _joy: 0.25
    _anger: 0
    _fear: 0
    _sadness: 0.3
  GoodFraction: 0.7
  ConsequenceTitle: Saturday, 3 pm
  GoodCaption: A video call from the party.
  MixedCaption: The birthday card is still closed.
  CriticalCaption: An empty chair at the party.
  GoodImage: {fileID: 2800000, guid: da4db2eaf7a27db42bea3758d5bb7a20, type: 3}
  MixedImage: {fileID: 2800000, guid: 38ae523641cf11647b89a179409748bb, type: 3}
  CriticalImage: {fileID: 2800000, guid: d14e4ed1ff04e264da06223976e3db4d, type: 3}
  GranddaughterClip: {fileID: 8300000, guid: 23caa1b963344ea49b7d86f301fb176f, type: 3}
  GranddaughterText: Grandpa! Look, I'm six! We saved you a piece of cake!
  ConsequenceSeconds: 10
